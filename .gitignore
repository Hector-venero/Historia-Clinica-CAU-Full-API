bfa-node/nucleo/test2network/*.json
bfa-node/nucleo/test2network/geth.ipc
bfa-node/nucleo/test2network/static-nodes.json

# Ignorar también contenedores locales del nodo
bfa-node/nucleo/
bfa-node/container/
bfa-node/keystore/
bfa-node/geth/

