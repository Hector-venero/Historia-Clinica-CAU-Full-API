# =====================================
#  PYTHON / FLASK
# =====================================
__pycache__/
*.pyc
*.pyo
instance/
.env
*.env
.env.*
# 'env' sin punto NO lo atrapaba ninguno de los patrones de arriba:
# asi se filtro un archivo con secretos reales al fork publico.
env
env.*
!env.example

# Conf de nginx de un despliegue concreto (dominio + rutas de certificados).
# Se genera desde nginx/default.ssl.conf.example.
nginx/default.prod.conf
*.sqlite3
*.db
venv/
# Patron pensado para el migrations/ que genera Flask-Migrate (que este
# proyecto no usa), pero al no estar anclado matcheaba tambien db/migrations/
# y dejaba las migraciones SQL fuera del repo sin que nada avisara.
/migrations/
!db/migrations/
*.log
*.tmp

# Archivos de subida o generados por usuarios
app/uploads/
**/uploads/

# =====================================
