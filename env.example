# ==============================
#  FLASK CONFIG
# ==============================
# production | development
FLASK_ENV=production
FLASK_DEBUG=False
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ==============================
#  DATABASE CONFIG
# ==============================
DB_HOST=db
DB_USER=
DB_PASSWORD=
DB_NAME=
# Requerida por docker-compose (falta en el env original)
MYSQL_ROOT_PASSWORD=

# Migraciones. El usuario de la app (DB_USER) solo tiene DML; las migraciones
# necesitan DDL (ALTER/CREATE/INDEX/REFERENCES), por eso van con credenciales
# propias. El backend las aplica al arrancar, asi que si estas faltan el
# contenedor no levanta: falla con el error 1142.
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=

# ==============================
#  PLATAFORMA (multi-consultorio)
# ==============================
# Plano de control: que consultorios existen y donde vive la base de cada uno.
# No contiene datos clinicos.
PLATAFORMA_DB_NAME=plataforma
PLATAFORMA_DB_USER=root
PLATAFORMA_DB_PASSWORD=

# Cifra las credenciales que la plataforma guarda por cliente (la clave de su
# base, el token de recetas). Se cifran y no se hashean porque hay que
# recuperarlas para usarlas.
#
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ROTARLA INVALIDA TODO LO CIFRADO: primero descifrar con la vieja y recifrar.
PLATAFORMA_SECRET_KEY=

# Dias de prueba gratis para un consultorio nuevo.
DIAS_DE_PRUEBA=30

# Interruptor de la multi-tenencia. APAGADO por defecto: sin el, la aplicacion
# se comporta como una instalacion de un solo centro y la base sale de DB_NAME.
# Es lo que mantiene funcionando al CAU con este mismo codigo.
MULTI_TENANT=false

# Dominio bajo el que cuelgan los subdominios: drlopez.miproducto.com.
# Vacio en desarrollo (se toma la primera etiqueta de drlopez.localhost).
#
# En produccion DECLARALO: sin el, cualquier dominio que alguien apunte a este
# servidor resolveria como el consultorio que coincida con su primera etiqueta.
DOMINIO_BASE=

# Cuanto se cachea el catalogo de clientes. Corto a proposito: suspender a un
# cliente tiene que surtir efecto en minutos, no al reiniciar el proceso.
TTL_CACHE_CLIENTES=60

# ==============================
#  MAIL CONFIG
# ==============================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
# App-password de Gmail (16 chars, sin espacios)
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# ==============================
#  BLOCKCHAIN (BFA / TSA)
# ==============================
# Clave privada de la wallet BFA. NUNCA commitear con valor.
PRIVATE_KEY_BFA=
ADDRESS_BFA=
# API oficial de Timestamp Authority de BFA
BFA_TSA_URL=https://tsaapi.bfa.ar/api/tsa
# Habilita /api/blockchain/test_tx (solo dev)
ENABLE_BLOCKCHAIN_TEST_ENDPOINTS=False

# ==============================
#  RECETAS ELECTRONICAS (QBI2 / Qbitos)
# ==============================
# SIN default a proposito: apuntar explicitamente al ambiente correcto. Antes
# caia a homologacion, asi que olvidarla en produccion emitia recetas contra el
# ambiente de pruebas sin avisar. Sin valor, el modulo responde 503.
# Homologacion: https://apirecipe.hml.qbitos.com
# Produccion:   consultar al proveedor
#
# Los nombres son QBI_*, que es lo que lee config.py. Este archivo decia
# QBITOS_RECIPE_*, que no los lee nadie: quien copiara el ejemplo y los
# completara igual se quedaba con el modulo de recetas en 503.
QBI_BASE_URL=
QBI_TOKEN=
QBI_CLIENT_ID=
QBI_TIMEOUT=30

# ==============================
#  FRONTEND
# ==============================
# En produccion siempre /api (nginx hace el proxy)
VITE_API_URL=/api
FRONTEND_URL=

# ==============================
#  CORS
# ==============================
# Opcional: lista separada por comas. Si se omite, se deriva de FRONTEND_URL/FLASK_ENV
CORS_ORIGINS=

# ==============================
#  NGINX / DEPLOY
# ==============================
# Dev (el unico que existe hoy): ./nginx/default.conf
# Prod con SSL: copiar ./nginx/default.ssl.conf.example, completar el dominio y
# apuntar esta variable al archivo resultante.
#
# Apuntaba a ./nginx/default.dev.conf, que no existe en el repositorio. Docker
# crea un directorio vacio cuando el origen de un bind mount no existe, asi que
# nginx arrancaba sin la configuracion del proyecto.
NGINX_CONF_FILE=./nginx/default.conf

# ==============================
#  MISC
# ==============================
TZ=America/Argentina/Buenos_Aires

# Backup automatico remoto (opcional)
REMOTE_BACKUP_USER=
REMOTE_BACKUP_HOST=

# ============================================================
# Plataforma SaaS (rama saas/multi-tenant)
# ============================================================
# Apagado por defecto: sin esto la aplicacion se comporta como una instalacion
# de un solo centro, que es como corre el CAU.
MULTI_TENANT=false

# Marca del producto. Solo se usan SIN consultorio resuelto (el sitio publico).
# Con un consultorio, gana su nombre_visible o el nombre con el que se dio de
# alta. Una instalacion de un solo centro las define para verse con su marca:
#   MARCA_NOMBRE="Centro Asistencial Universitario UNSAM"
#   MARCA_NOMBRE_CORTO="CAU UNSAM"
MARCA_NOMBRE=
MARCA_NOMBRE_CORTO=
MARCA_LOGO=

# Dominio bajo el que cuelgan los subdominios de los consultorios.
# De drlopez.miproducto.com extrae 'drlopez'.
# SIN DEFINIRLO, cualquier host que apunte al servidor se interpreta como un
# consultorio. Es obligatorio en produccion.
DOMINIO_BASE=

# Plano de control: que consultorios existen y donde vive la base de cada uno.
PLATAFORMA_DB_NAME=plataforma
PLATAFORMA_DB_USER=
PLATAFORMA_DB_PASSWORD=

# Cifra las credenciales que la plataforma guarda por cliente. Sin ella el
# arranque falla, en vez de guardarlas en claro.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotarla invalida todo lo cifrado: hay que descifrar con la vieja y recifrar.
PLATAFORMA_SECRET_KEY=

# Dias de prueba de un consultorio nuevo.
DIAS_DE_PRUEBA=30
# Cuantos dias antes del vencimiento se avisa por mail.
DIAS_AVISO_VENCIMIENTO=5
# Cuanto se retiene la base de un cancelado antes de poder borrarla.
DIAS_RETENCION_CANCELADOS=90

# Cuanto se cachea el catalogo de clientes. Es tambien lo que tarda un cambio de
# estado en surtir efecto.
TTL_CACHE_CLIENTES=60
